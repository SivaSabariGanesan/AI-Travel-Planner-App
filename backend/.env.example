# Backend environment variables
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_travel_planner

# JWT Configuration (REQUIRED for authentication)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# OTP Configuration (REQUIRED for email verification)
OTP_SECRET=your-otp-secret-key-min-32-chars
OTP_EXPIRY_MINUTES=10

# Gemini (company) API key - keep this secret and only on backend
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Encryption secret for encrypting user-provided Gemini keys (min 24 chars)
GEMINI_KEY_ENCRYPTION_SECRET=your-encryption-secret-min-24-chars

# AI rate limiting
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# Email Configuration (SMTP) - required for OTP emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your-app-password-not-regular-password
SMTP_FROM=AI Travel Planner <no-reply@example.com>

# Local testing helpers (set DISABLE_AUTH_FOR_LOCAL=true to skip auth for testing)
DISABLE_AUTH_FOR_LOCAL=false
LOCAL_TEST_USER_ID=67e000000000000000000001
LOCAL_TEST_USER_EMAIL=local@test.com
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_travel_planner
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d
OTP_SECRET=replace-with-a-strong-otp-secret
OTP_EXPIRY_MINUTES=10
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM=AI Travel Planner <no-reply@example.com>

# Local testing helpers
DISABLE_AUTH_FOR_LOCAL=true
LOCAL_TEST_USER_ID=67e000000000000000000001
LOCAL_TEST_USER_EMAIL=local@test.com
